RELEASEROOM_STATE_DIR=/var/lib/releaseroom
RELEASEROOM_ORIGIN=https://your-release-room.example
RELEASEROOM_HOST=127.0.0.1
RELEASEROOM_PORT=8090
RELEASEROOM_SWITCH_URL=https://your-switch-server.example
RELEASEROOM_ROOM_ID=
RELEASEROOM_AGENT_FILE=/etc/releaseroom/switch-agents.json
RELEASEROOM_REVIEWERS=[]
RELEASEROOM_REQUESTERS=[]
RELEASEROOM_MODEL_PROVIDER=vultr
RELEASEROOM_MODEL=glm-5.3-flash
RELEASEROOM_MODEL_KEY_FILE=/etc/releaseroom/model-key.txt
# The legacy Vultr key setting remains supported when MODEL_KEY_FILE is unset.
RELEASEROOM_VULTR_KEY_FILE=/etc/releaseroom/vultr-key.txt
RELEASEROOM_ACCESS_FILE=/etc/releaseroom/team-access.txt
